# Copy to .env (gitignored) and fill in. reflow reads these from the environment,
# never from this file, so load it into your shell before running reflow:
#     set -a; source .env; set +a

# Secret: your provider's API key. Never commit it; never put it in reflow.toml.
REFLOW_API_KEY=

# Which model to use (reflow.toml holds only max_attempts / compile_cap).
REFLOW_PROVIDER=openai-compatible
REFLOW_MODEL=nvidia/nemotron-3.5-super-vl:free
REFLOW_BASE_URL=https://openrouter.ai/api
REFLOW_TIMEOUT_S=300
REFLOW_MAX_TOKENS=12000

# Or use your Claude Code login instead of an API key (no credits): install Claude Code,
# log in, then set these and leave REFLOW_API_KEY empty. Each model call runs `claude -p`
# with every tool off, in an empty temporary folder, with no session saved, and it counts
# against your subscription's usage limits. REFLOW_MODEL is a Claude Code model name
# (for example sonnet or opus); leave it empty for your Claude Code default.
# REFLOW_PROVIDER=claude-code
# REFLOW_MODEL=sonnet
