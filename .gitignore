# Python
.venv/
__pycache__/
*.egg-info/

# Scratch experiments
scratch/

# Tools / builds
tools/*.jar
node_modules/
*.zip

# AI agent skill files installed by tsci init
.claude/
.agents/

# KiCad local state
*.lck
*.kicad_prl
fp-info-cache
.history/
*-backups/
kicad/

# macOS
.DS_Store
.pytest_cache/
.vscode/

# reflow run folders
runs/

# Board projects made with `reflow tui` in boards/: the datasheet is the vendor's (never committed),
# its text copy too, and .reflow/ is the TUI's own progress. spec.json, plan.json, rules.toml stay.
boards/*/*.pdf
boards/*/*.txt
boards/*/.reflow/

# Test inputs the patterns above would otherwise hide (tests/test_repo_hygiene.py)
!tests/data/pinmaps/kicad/
!tests/data/snapshot/cache.zip

# Local settings and secrets (REFLOW_API_KEY): never committed. See .env.example.
.env
